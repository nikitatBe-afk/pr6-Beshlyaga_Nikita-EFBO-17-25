digraph G {
graph [rankdir=TB, bgcolor="white", pad=0.2, nodesep=0.25, ranksep=0.35];
node [shape=box, style="rounded,filled", fontname="Times New Roman", fontsize=11, color="#2F5597", fillcolor="#EAF2F8", margin="0.12,0.08"];
edge [fontname="Times New Roman", fontsize=9, color="#555555"];
start [label="Начало", shape=oval, fillcolor="#E2F0D9", color="#548235"];
end [label="Завершение", shape=oval, fillcolor="#FCE4D6", color="#C65911"];
n1 [label="Получить параметры заявки", shape=parallelogram, fillcolor="#E4DFEC", color="#7030A0"];
n2 [label="Есть персональные данные?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n3 [label="Риск HIGH?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n4 [label="Сумма >= FINANCE_LIMIT?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n5 [label="Срочная заявка?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n6 [label="Подходит для STANDARD?\namount < 50000, !urgent, risk == LOW, !personal", shape=diamond, fillcolor="#F4CCCC", color="#C00000"];
n7 [label="Риск не LOW?", shape=diamond, fillcolor="#FFF2CC", color="#BF9000"];
n8 [label="Вернуть маршрут согласования"];
start -> n1;
n1 -> n2;
n2 -> n8 [label="да  SECURITY_REVIEW"];
n2 -> n3 [label="нет"];
n3 -> n8 [label="да  DIRECTOR_REVIEW"];
n3 -> n4 [label="нет"];
n4 -> n8 [label="да  FINANCE_REVIEW"];
n4 -> n5 [label="нет"];
n5 -> n8 [label="да  FAST_TRACK"];
n5 -> n6 [label="нет"];
n6 -> n8 [label="да  STANDARD"];
n6 -> n7 [label="нет"];
n7 -> n8 [label="да  DIRECTOR_REVIEW"];
n7 -> n8 [label="нет  FINANCE_REVIEW"];
n8 -> end;
}

digraph ApprovalClasses {
    graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.55, ranksep=0.6,
           label="Итоговая диаграмма классов — практическая работа №6", labelloc=t,
           fontname="Times New Roman", fontsize=18];
    node [shape=record, style=filled, fontname="Times New Roman", fontsize=11,
          color="#2F5597", fillcolor="#F7FBFF", margin="0.12,0.09"];
    edge [fontname="Times New Roman", fontsize=10, color="#555555", style=dashed, arrowhead=open];

    router [label="{ApprovalRouter|+ FINANCE_LIMIT: long = 500000\l+ STANDARD_LIMIT: long = 50000\l|+ route(long, boolean, RiskLevel, boolean): ApprovalRoute\l+ addStandardEligibility(long, boolean, RiskLevel, boolean): boolean\l}",
            fillcolor="#FDE9E7", color="#C00000"];
    route [label="{ApprovalRoute «enum»|STANDARD\lFAST_TRACK\lFINANCE_REVIEW\lDIRECTOR_REVIEW\lSECURITY_REVIEW\l}"];
    risk [label="{RiskLevel «enum»|LOW\lMEDIUM\lHIGH\l}"];
    check [label="{SelfCheck|+ main(String[]): void\l- parseBoolean(String, String): boolean\l}"];

    router -> route [label="returns"];
    router -> risk [label="uses"];
    check -> router [label="checks"];
    check -> route [label="compares"];
    check -> risk [label="uses"];
}
